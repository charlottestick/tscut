{
  "name": "tscut",
  "productName": "tscut",
  "version": "1.6.5",
  "description": "Crossplatform reimplementation of Jumpcut using typescript and electron",
  "keywords": [],
  "author": {
    "name": "Charlotte Stick",
    "email": "charlie.stick@btinternet.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:charlottestick/tscut"
  },
  "main": ".webpack/main",
  "scripts": {
    "dev": "electron-forge start",
    "start": "npm run dev",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "publish": "dotenv -- electron-forge publish",
    "publish:ci": "git push --follow-tags",
    "version:major": "npm version major && npm run publish:ci",
    "version:minor": "npm version minor && npm run publish:ci",
    "version:patch": "npm version patch && npm run publish:ci",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.13",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^7.1.4",
    "dotenv-cli": "^7.4.2",
    "electron": "^43.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.0.0",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
